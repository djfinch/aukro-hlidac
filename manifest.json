{
  "manifest_version": 3,
  "name": "Aukro Hlídač Uživatelů",
  "version": "1.5",
  "author": "djfinch",
  "homepage_url": "https://github.com/djfinch/aukro-hlidac",
  "description": "Označí vybrané uživatele na Aukro.cz symbolem s poznámkou a upozorní změnou ikony. © 2026 djfinch",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["*://*.aukro.cz/*"],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.aukro.cz/*"],
      "js": ["content.js"]
    }
  ]
}
